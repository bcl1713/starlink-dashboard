-    return response.data;
+  async get(
+    signal?: AbortSignal,
+    diagnosticId?: string
+  ): Promise<OverviewHistoryBundle> {
+    const id = diagnosticId ?? perf391?.requestId();
+    perf391?.request(id, signal);
+    try {
+      const response = await apiClient.get<OverviewHistoryBundle>(
+        '/api/overview-history',
+        { signal, ...(id ? { headers: { 'x-diagnostic-id': id } } : {}) }
+      );
+      perf391?.response(id, response.data);
+      return response.data;
+    } catch (error) {
+      perf391?.requestError(id, signal);
+      throw error;
+    }
   },
 };
 

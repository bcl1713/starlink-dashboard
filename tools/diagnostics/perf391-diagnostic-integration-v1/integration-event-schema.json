  "required": [
    "schema",
    "version",
    "role",
    "emitter",
    "run_id",
    "stream_id",
    "seq",
    "process_uuid",
    "pid",
    "tid",
    "process_start_id",
    "thread_start_id",
    "clock_id",
    "mono_ns",
    "thread_cpu_ns",
    "op_id",
    "parent_op_id",
    "span_id",
    "operation_type",
    "phase",
    "outcome",
    "identity",
    "unavailable"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "emitter": {
            "const": "browser"
          }
        }
      },
      "then": {
        "properties": {
          "tid": {
            "type": "null"
          },
          "thread_start_id": {
            "type": "null"
          },
          "thread_cpu_ns": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "role": {
            "const": "A"
          }
        }
      },
      "then": {
        "properties": {
          "phase": {
            "not": {
              "enum": [
                "producer.published",
                "producer.validated",
                "source.final.begin",
                "source.final.end",
                "publication.attempt",
                "publication.result",
                "publication.swap"
              ]
            }
          },
          "identity": {
            "not": {
              "anyOf": [
                {
                  "required": ["expected_head"]
                },
                {
                  "required": ["publication_token"]
                },
                {
                  "required": ["frame_id"]
                },
                {
                  "required": ["cas_success"]
                },
                {
                  "required": ["publication_kind"]
                }
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "const": "producer.published"
          }
        }
      },
      "then": {
        "properties": {
          "role": {
            "const": "C"
          },
          "outcome": {
            "const": "ok"
          },
          "identity": {
            "required": ["publication_kind", "cas_success"],
            "properties": {
              "publication_kind": {
                "const": "ready"
              },
              "cas_success": {
                "const": true
              }
            }
          },
          "operation_type": {
            "enum": ["tick", "replay"]
          }
        }
      }
    }

diff --git a/tools/diagnostics/perf391-diagnostic-integration-v1/integration.py b/tools/diagnostics/perf391-diagnostic-integration-v1/integration.py
new file mode 100644
index 00000000..7c50bd29
--- /dev/null
+++ b/tools/diagnostics/perf391-diagnostic-integration-v1/integration.py
@@ -0,0 +1,418 @@
+"""Offline adapter owner. Accepts Stage 2 drain and Stage 3A browser sink records.
+
+No HTTP or browser launch path exists here. Artifact loaders must return bounded
+bytes. Projection never infers an association from equal timestamps or values.
+"""
+
+import hashlib
+import json
+import uuid
+
+import build
+from evidence import BrowserProjection, canonical
+from host import anchor
+
+
+def normalize_history(history, *, viewer, request, bundle, segment="measured"):
+    return {
+        "viewer": viewer,
+        "request_id": request,
+        "bundle_id": bundle,
+        "start": history["start_timestamp_seconds"],
+        "end": history["end_timestamp_seconds"],
+        "step": history["step_seconds"],
+        "series": history["series"],
+        **({"rolling_5m": history["rolling_5m"]} if history.get("rolling_5m") else {}),
+        "segment": segment,
+    }
+
+
+class Integration:
+    def __init__(self, sink, *, role, run, page="p", module_hashes=None):
+        self.sink = sink
+        self.role = role
+        self.run = run
+        self.page = page
+        self.browser = BrowserProjection(role, run, page)
+        self.module_hashes = module_hashes or {}
+        self.node_uuid = str(uuid.uuid4())
+        self.node_start = str(__import__("time").monotonic_ns())
+        self.node_stream = self.node_uuid + "/host"
+        self.node_seq = 0
+        self.node_identity = None
+        self.browser_streams = {}
+        self.backend_streams = {}
+        self.observer_streams = {}
+        self.paint_streams = {}
+        self.paint_requests = {}
+        self.paint_serial = 0
+        self.closed = False
+
+    def backend(self, rows):
+        for row in rows:
+            if row["emitter"] != "backend" or row["role"] != self.role:
+                raise ValueError("backend role/emitter")
+            self.backend_streams[row["stream_id"]] = row["seq"]
+            self.sink.accept(row)
+
+    def finish_backend(self, stats):
+        loss = sum(stats.get(key, 0) for key in ("dropped", "invalid", "failures"))
+        if loss or stats.get("buffered") != 0:
+            self.sink.failed = True
+        for stream, seq in self.backend_streams.items():
+            self.sink.summary(
+                stream, last_seq=seq, dropped=loss, complete=stats.get("buffered") == 0
+            )
+
+    def _v1(self, kind, data, *, mono=None, clock=None, op=None):
+        # Data-only records originate in the collector; no browser/native TID claim.
+        try:
+            accepted = self.sink.v1.emit(
+                kind, data, mono_ns=mono, clock_id=clock or self.node_uuid, op_id=op
+            )
+            if not accepted:
+                self.sink.failed = True
+            return accepted
+        except (ValueError, OSError):
+            self.sink.failed = True
+            self.sink.dropped += 1
+            return False
+
+    def browser_record(self, row, *, load=None):
+        if self.closed:
+            raise RuntimeError("closed adapter")
+        raw = row.get("event")
+        artifact = None
+        if raw is not None:
+            if row.get("sha256"):
+                if load is None:
+                    raise ValueError("artifact loader unavailable")
+                body = load(row["artifact"])
+                if (
+                    len(body) > 2097152
+                    or hashlib.sha256(body).hexdigest() != row["sha256"]
+                ):
+                    raise ValueError("browser artifact identity/budget")
+                complete = json.loads(body)
+                if {k: v for k, v in complete.items() if k != "detail"} != raw:
+                    raise ValueError("browser header/artifact identity")
+                raw = complete
+                artifact = self.sink.artifact(body)
+            page = raw["stream"].split("/")[1]
+            if (
+                page not in ("p", "p1", "p2", "viewer1", "viewer2")
+                and not page == self.page
+            ):
+                raise ValueError("unregistered browser page")
+            browser = BrowserProjection(self.role, self.run, page)
+            event = browser.event(raw, artifact=artifact)
+            self.browser_streams[event["stream_id"]] = event["seq"]
+            self.sink.accept(event)
+            detail = raw.get("detail", {})
+            request = raw.get("op")
+            if (
+                raw["phase"] == "app.parse_available"
+                and request
+                and detail.get("history")
+            ):
+                self._v1(
+                    "history",
+                    normalize_history(
+                        detail["history"],
+                        viewer=page,
+                        request=request,
+                        bundle=detail["bundle"],
+                    ),
+                    op=request,
+                )
+            if raw["phase"] == "plot.commit":
+                # Exact actual retained input and committed arrays are mandatory.
+                required = (
+                    "retained",
+                    "projection",
+                    "plot",
+                    "accepted",
+                    "acceptedRequest",
+                    "metric",
+                    "commit",
+                )
+                if (
+                    not all(k in detail for k in required)
+                    or not artifact
+                    or detail["acceptedRequest"] != request
+                    or not self.module_hashes
+                ):
+                    self._v1(
+                        "coverage",
+                        {
+                            "boundary": "chart.input",
+                            "available": False,
+                            "reason": "missing actual retained/plot/provenance/module hashes",
+                        },
+                    )
+                    return
+                for name in ("retained", "projection", "plot"):
+                    snap = row.get("snapshots", {}).get(name)
+                    if not snap or load is None:
+                        self.sink.failed = True
+                        raise ValueError("snapshot unavailable")
+                    try:
+                        data = load(snap["artifact"])
+                    except (OSError, KeyError, ValueError):
+                        self.sink.failed = True
+                        raise ValueError("snapshot reference unavailable") from None
+                    if (
+                        len(data) > 2097152
+                        or hashlib.sha256(data).hexdigest() != snap["sha256"]
+                        or json.loads(data) != detail[name]
+                    ):
+                        self.sink.failed = True
+                        raise ValueError("snapshot hash/content mismatch")
+                    if self.sink.artifact(data)["state"] != "available":
+                        raise ValueError("snapshot storage unavailable")
+                data = detail["plot"]["data"]
+                scales = detail["plot"]["scales"]["x"]
+                projection = normalize_history(
+                    detail["retained"],
+                    viewer=page,
+                    request=request,
+                    bundle=detail["accepted"],
+                )
+                self._v1(
+                    "chart",
+                    {
+                        "viewer": page,
+                        "request_id": request,
+                        "bundle_id": detail["accepted"],
+                        "series": detail["metric"],
+                        "segment": "measured",
+                        "times": data[0],
+                        "traces": dict(
+                            zip(("max", "min", "avg", "observed"), data[1:])
+                        ),
+                        "viewport": [scales["min"], scales["max"]],
+                        "visible_gaps": None,
+                        "module_hashes": self.module_hashes,
+                        "paint_evidence": None,
+                        "input_stage": "plot",
+                        "log_floor": detail.get("logFloor"),
+                        "projection_input": projection,
+                    },
+                    op=request,
+                )
+            return
+        phase = {
+            "browser.response": "browser.headers",
+            "browser.finished": "browser.end",
+        }.get(row.get("phase"), row.get("phase"))
+        if phase not in (
+            "browser.request",
+            "browser.headers",
+            "browser.end",
+            "browser.failed",
+            "paint.request",
+            "paint.artifact",
+        ):
+            raise ValueError("unsupported host browser event")
+        page = row.get("page_id", self.page)
+        supplied = row.get("host_identity")
+        if not supplied:
+            raise ValueError("Node emitter identity unavailable")
+        if self.node_identity is not None and supplied != self.node_identity:
+            raise ValueError("Node restart requires new adapter")
+        self.node_identity = supplied
+        self.node_stream = supplied["process_uuid"] + "/node"
+        self.node_seq += 1
+        identity = {"viewer_id": page}
+        if row.get("requestId"):
+            identity["request_id"] = row["requestId"]
+        if phase == "paint.artifact":
+            reference = None
+            if row.get("sha256") and row.get("artifact") and load is not None:
+                try:
+                    body = load(row["artifact"])
+                except (OSError, KeyError, ValueError):
+                    self.sink.failed = True
+                    raise ValueError("PNG reference unavailable") from None
+                if (
+                    len(body) > 2097152
+                    or hashlib.sha256(body).hexdigest() != row["sha256"]
+                ):
+                    self.sink.failed = True
+                    raise ValueError("PNG hash/body budget")
+                reference = self.sink.artifact(body)
+            if reference and reference["state"] == "available":
+                identity["artifact_sha256"] = reference["sha256"]
+            else:
+                identity["artifact_sha256"] = None
+        event = {
+            "schema": build.SCHEMA,
+            "version": 1,
+            "role": self.role,
+            "emitter": "node",
+            "run_id": self.run,
+            "stream_id": self.node_stream,
+            "seq": self.node_seq,
+            "process_uuid": supplied["process_uuid"],
+            "pid": supplied["pid"],
+            "tid": None,
+            "process_start_id": supplied["process_start_id"],
+            "thread_start_id": None,
+            "clock_id": supplied["clock_id"],
+            "mono_ns": row["host_received_ns"],
+            "thread_cpu_ns": None,
+            "op_id": row.get("requestId") or f"{self.page}/host/{self.node_seq}",
+            "parent_op_id": None,
+            "span_id": None,
+            "operation_type": (
+                "presentation" if phase.startswith("paint.") else "history"
+            ),
+            "phase": phase,
+            "outcome": row.get("outcome", "ok"),
+            "identity": identity,
+            "unavailable": {},
+        }
+        if phase.startswith("paint."):
+            key = (page, row.get("panel"), row.get("commit"), row.get("started_ns"))
+            if phase == "paint.request":
+                if key in self.paint_requests or len(self.paint_requests) >= 8:
+                    self.sink.failed = True
+                    raise ValueError("paint request identity/budget")
+                self.paint_serial += 1
+                stream = self.node_stream + "/paint" + str(self.paint_serial)
+                self.paint_requests[key] = stream
+                event.update(
+                    stream_id=stream,
+                    seq=1,
+                    mono_ns=row["started_ns"],
+                    op_id=f"{page}/paint/{self.paint_serial}",
+                )
+                self.paint_streams[stream] = 1
+            else:
+                stream = self.paint_requests.pop(key, None)
+                if stream:
+                    event.update(
+                        stream_id=stream,
+                        seq=2,
+                        mono_ns=row["received_ns"],
+                        op_id=f'{page}/paint/{stream.rsplit("paint",1)[1]}',
+                    )
+                    self.paint_streams[stream] = 2
+                else:
+                    self.paint_serial += 1
+                    stream = self.node_stream + "/paint" + str(self.paint_serial)
+                    event.update(
+                        stream_id=stream,
+                        seq=1,
+                        mono_ns=row["received_ns"],
+                        op_id=f"{page}/paint/{self.paint_serial}",
+                        outcome="unavailable",
+                    )
+                    self.paint_streams[stream] = 1
+                if identity.get("artifact_sha256") is None:
+                    event["outcome"] = "unavailable"
+                    event["unavailable"] = {
+                        "artifact_sha256": "missing verified compositor artifact"
+                    }
+            self.node_seq -= 1
+        self.sink.accept(event)
+
+    def finish_browser(self, summary):
+        lost = summary.get("lost", 0)
+        complete = (
+            summary.get("closed") is True
+            and not summary.get("failed")
+            and not any(
+                summary.get(k, 0)
+                for k in (
+                    "active",
+                    "pending",
+                    "jobs",
+                    "bindingJobs",
+                    "ownedOperations",
+                    "assemblies",
+                    "bytes",
+                )
+            )
+        )
+        if lost or not complete or self.paint_requests:
+            self.sink.failed = True
+            complete = False
+        for stream, seq in self.browser_streams.items():
+            self.sink.summary(stream, last_seq=seq, dropped=lost, complete=complete)
+        if self.node_seq:
+            self.sink.summary(
+                self.node_stream,
+                last_seq=self.node_seq,
+                dropped=lost,
+                complete=complete,
+            )
+        for stream, seq in self.paint_streams.items():
+            self.sink.summary(stream, last_seq=seq, dropped=lost, complete=complete)
+
+    def source_record(self, row):
+        raw = row["event"]
+        if raw.get("run", self.run) != self.run:
+            raise ValueError("observer run mismatch")
+        node = row["host_identity"]
+        stream = node["process_uuid"] + "/observer"
+        identity = {"request_id": raw["op"]}
+        if raw.get("skipped"):
+            identity["branch"] = "skipped:" + str(raw["skipped"])
+        if raw.get("late_ns"):
+            identity["observation_timestamp"] = raw["late_ns"]
+        # Scheduling fields are stored in hashed raw records by collect.mjs;
+        # observation_timestamp is reserved for source acquisition, never late-wake.
+        identity.pop("observation_timestamp", None)
+        event = {
+            "schema": build.SCHEMA,
+            "version": 1,
+            "role": self.role,
+            "emitter": "observer",
+            "run_id": self.run,
+            "stream_id": stream,
+            "seq": raw["seq"],
+            "process_uuid": node["process_uuid"],
+            "pid": node["pid"],
+            "tid": None,
+            "process_start_id": node["process_start_id"],
+            "thread_start_id": None,
+            "clock_id": node["clock_id"],
+            "mono_ns": raw["mono_ns"],
+            "thread_cpu_ns": None,
+            "op_id": raw["op"],
+            "parent_op_id": None,
+            "span_id": None,
+            "operation_type": "source_observer",
+            "phase": raw["phase"],
+            "outcome": raw.get("outcome", "ok"),
+            "identity": identity,
+            "unavailable": {},
+        }
+        self.observer_streams[stream] = raw["seq"]
+        self.sink.accept(event)
+
+    def finish_source(self, summary):
+        if summary.get("failed") or not summary.get("closed"):
+            self.sink.failed = True
+        for stream, seq in self.observer_streams.items():
+            self.sink.summary(
+                stream,
+                last_seq=seq,
+                dropped=int(summary.get("failed", False)),
+                complete=summary.get("closed", False),
+            )
+
+    def resources(self, snapshot):
+        self._v1("resource", {"files": snapshot["files"]})
+        return self.sink.artifact(canonical(snapshot))
+
+    def clock_anchor(self, **kwargs):
+        value = anchor(self.node_uuid, **kwargs)
+        self._v1(
+            "anchor",
+            {"utc_ns": value["utc_ns"], "uncertainty_ns": value["uncertainty_ns"]},
+            mono=value["mono_ns"],
+            clock=self.node_uuid,
+        )
+        return value
diff --git a/tools/diagnostics/perf391-diagnostic-integration-v1/observer.mjs b/tools/diagnostics/perf391-diagnostic-integration-v1/observer.mjs
new file mode 100644
index 00000000..31cca046
--- /dev/null
+++ b/tools/diagnostics/perf391-diagnostic-integration-v1/observer.mjs
@@ -0,0 +1,263 @@
+/** Supplemental source observer. Importing never sends traffic or starts timers. */
+import http from "node:http";
+import { createGunzip } from "node:zlib";
+import { TextDecoder } from "node:util";
+import { setTimeout as sleep } from "node:timers/promises";
+export const LIMITS = Object.freeze({
+  body: 2 * 1024 * 1024,
+  headers: 64 * 1024,
+  deadline: 2000,
+  period: 1000000000n,
+});
+function endpoint(url) {
+  const u = new URL(url);
+  if (
+    u.protocol !== "http:" ||
+    !["127.0.0.1", "[::1]"].includes(u.hostname) ||
+    u.pathname !== "/api/_diagnostic/state" ||
+    u.search ||
+    u.hash ||
+    u.username ||
+    u.password
+  )
+    throw Error("dedicated loopback diagnostic endpoint required");
+  return u;
+}
+export async function readResponse({
+  url,
+  op,
+  request = http.request,
+  signal,
+  mark = () => {},
+  timers = globalThis,
+}) {
+  const target = endpoint(url);
+  if (!/^[\x21-\x7e]{1,96}$/.test(op)) throw Error("operation identity");
+  return new Promise((resolve) => {
+    let req,
+      res,
+      decoder,
+      timer,
+      done = false,
+      encoded = 0,
+      decoded = 0;
+    const chunks = [];
+    function finish(result) {
+      if (done) return;
+      done = true;
+      timers.clearTimeout(timer);
+      signal?.removeEventListener("abort", cancel);
+      // No keep-alive agent; every socket/decoder belongs to this invocation.
+      decoder?.destroy();
+      res?.destroy();
+      req?.destroy();
+      chunks.length = 0;
+      resolve(result);
+    }
+    const fail = (reason) => finish({ ok: false, reason, encoded, decoded });
+    const cancel = () => fail("cancelled");
+    function collect(chunk) {
+      if (done) return;
+      if (decoded + chunk.length > LIMITS.body) return fail("decoded_limit");
+      decoded += chunk.length;
+      chunks.push(chunk);
+    }
+    function parsed() {
+      if (done) return;
+      mark("observer.received");
+      let value;
+      try {
+        value = new TextDecoder("utf-8", { fatal: true }).decode(
+          Buffer.concat(chunks, decoded),
+        );
+      } catch {
+        return fail("utf8");
+      }
+      try {
+        value = JSON.parse(value);
+        if (!value || typeof value !== "object" || Array.isArray(value))
+          throw Error();
+      } catch {
+        return fail("json");
+      }
+      mark("observer.parsed");
+      const body = Buffer.concat(chunks, decoded);
+      finish({ ok: true, value, body, encoded, decoded });
+    }
+    timer = timers.setTimeout(() => fail("deadline"), LIMITS.deadline);
+    signal?.addEventListener("abort", cancel, { once: true });
+    if (signal?.aborted) return cancel();
+    try {
+      mark("observer.send");
+      req = request(
+        target,
+        {
+          method: "GET",
+          agent: false,
+          maxHeaderSize: LIMITS.headers,
+          headers: { "x-diagnostic-id": op },
+        },
+        (response) => {
+          res = response;
+          if (done) {
+            res.destroy();
+            return;
+          }
+          res.on("error", () => fail("transport"));
+          res.on("aborted", () => fail("transport"));
+          if (
+            Buffer.byteLength((res.rawHeaders ?? []).join("\r\n")) >
+            LIMITS.headers
+          )
+            return fail("header_limit");
+          mark("observer.headers");
+          if (res.statusCode < 200 || res.statusCode >= 300)
+            return fail("http_status");
+          const encoding = res.headers["content-encoding"] ?? "identity";
+          if (!["identity", "gzip"].includes(encoding)) return fail("encoding");
+          if (encoding === "gzip") {
+            decoder = createGunzip({ chunkSize: 16384 });
+            decoder.on("error", () => fail("gzip"));
+            decoder.on("data", collect);
+            decoder.on("end", parsed);
+          }
+          res.on("data", (chunk) => {
+            if (done) return;
+            if (encoded + chunk.length > LIMITS.body)
+              return fail("encoded_limit");
+            encoded += chunk.length;
+            if (decoder) decoder.write(chunk);
+            else collect(chunk);
+          });
+          res.on("end", () => {
+            if (!done) {
+              if (decoder) decoder.end();
+              else parsed();
+            }
+          });
+        },
+      );
+      req.on("error", () => fail("transport"));
+      req.end();
+    } catch {
+      fail("transport");
+    }
+  });
+}
+export async function observe({
+  run,
+  url,
+  samples,
+  write,
+  drain,
+  signal,
+  read = readResponse,
+  now = () => process.hrtime.bigint(),
+  wait = async (deadline, signal) => {
+    const remaining = deadline - process.hrtime.bigint();
+    if (remaining > 0n)
+      await sleep(Number((remaining + 999999n) / 1000000n), undefined, {
+        signal,
+      });
+  },
+}) {
+  endpoint(url);
+  if (
+    !/^synthetic-[A-Za-z0-9_-]{1,22}$/.test(run) ||
+    !Number.isInteger(samples) ||
+    samples < 1 ||
+    samples > 3600
+  )
+    throw Error("bounded synthetic run required");
+  const summary = {
+    completed: 0,
+    failed: false,
+    cancelled: false,
+    skipped: 0,
+    closed: false,
+  };
+  let deadline = now(),
+    seq = 0;
+  try {
+    for (let index = 1; index <= samples; index++) {
+      if (signal?.aborted) {
+        summary.cancelled = true;
+        break;
+      }
+      await wait(deadline, signal);
+      const op = `${run}/source/${index}`;
+      const mark = async (phase, extra = {}) =>
+        write({
+          run,
+          op,
+          seq: ++seq,
+          phase,
+          mono_ns: now().toString(),
+          ...extra,
+        });
+      // A scheduled boundary retains the actual absolute target; wake is captured separately.
+      await mark("observer.scheduled", { mono_ns: deadline.toString() });
+      await mark("observer.wake", {
+        late_ns: (now() > deadline ? now() - deadline : 0n).toString(),
+      });
+      // Transport marks must be captured synchronously even if sink is async.
+      const pending = [];
+      const result = await read({
+        url,
+        op,
+        signal,
+        mark: (phase) => {
+          const row = { run, op, seq: ++seq, phase, mono_ns: now().toString() };
+          pending.push(
+            Promise.resolve()
+              .then(() => write(row))
+              .then(
+                () => null,
+                (error) => error,
+              ),
+          );
+        },
+      });
+      const failures = await Promise.all(pending);
+      if (failures.some(Boolean)) throw failures.find(Boolean);
+      if (!result.ok) {
+        summary.failed = true;
+        summary.reason = result.reason;
+        await mark("probe.failure", {
+          outcome: result.reason === "cancelled" ? "cancelled" : "unavailable",
+          reason: result.reason,
+        });
+      }
+      await drain();
+      await mark("observer.written");
+      summary.completed++;
+      deadline += LIMITS.period;
+      if (deadline <= now()) {
+        const skipped = (now() - deadline) / LIMITS.period + 1n;
+        summary.skipped += Number(skipped);
+        await mark("observer.skipped_deadline", {
+          skipped: Number(skipped),
+          first_ns: deadline.toString(),
+        });
+        deadline += skipped * LIMITS.period;
+      }
+      await mark("observer.record_complete", {
+        outcome: result.ok ? "ok" : "unavailable",
+      });
+      await drain();
+      if (summary.failed) break;
+      if (signal?.aborted) {
+        summary.cancelled = true;
+        break;
+      }
+    }
+    await drain();
+  } catch (error) {
+    summary.failed = true;
+    summary.cancelled = signal?.aborted ?? false;
+    summary.reason = String(error.message).slice(0, 128);
+  } finally {
+    summary.closed = true;
+  }
+  return summary;
+}
diff --git a/tools/diagnostics/perf391-diagnostic-integration-v1/owner.py b/tools/diagnostics/perf391-diagnostic-integration-v1/owner.py
new file mode 100644
index 00000000..673b72db
--- /dev/null
+++ b/tools/diagnostics/perf391-diagnostic-integration-v1/owner.py
@@ -0,0 +1,311 @@
+"""Explicit process/lifecycle registry. No Docker, service or browser startup CLI.
+
+Only children created by this instance can enter the teardown registry. Group
+membership and /proc start identity are verified immediately before each signal.
+"""
+
+import asyncio
+import inspect
+import json
+import os
+import signal
+import subprocess
+import time
+from pathlib import Path
+
+
+def start_id(pid):
+    return Path(f"/proc/{pid}/stat").read_text().rsplit(")", 1)[1].split()[19]
+
+
+def members(group):
+    result = []
+    for path in Path("/proc").iterdir():
+        if not path.name.isdecimal():
+            continue
+        try:
+            pid = int(path.name)
+            if os.getpgid(pid) == group:
+                result.append({"pid": pid, "start_id": start_id(pid)})
+        except (OSError, IndexError):
+            pass
+    return result
+
+
+def direct_children():
+    result = []
+    for path in Path("/proc").iterdir():
+        if not path.name.isdecimal():
+            continue
+        try:
+            fields = (path / "stat").read_text().rsplit(")", 1)[1].split()
+            if int(fields[1]) == os.getpid():
+                result.append({"pid": int(path.name), "start_id": fields[19]})
+        except (OSError, IndexError):
+            pass
+    return result
+
+
+_DIRECT_OWNERS = {}
+
+
+class Owner:
+    def __init__(self, root, *, run, sources, adopt_descendants=False):
+        if not run.startswith("synthetic-") or len(run) > 96:
+            raise ValueError("synthetic owner required")
+        self.root = Path(root).absolute()
+        self.root.mkdir(parents=True, exist_ok=False)
+        self.children = []
+        self.callbacks = []
+        self.closing = None
+        self.adopt_descendants = adopt_descendants
+        self.baseline_children = {(r["pid"], r["start_id"]) for r in direct_children()}
+        self.manifest = {
+            "schema": "perf391-collection-owner-v1",
+            "version": 1,
+            "run_id": run,
+            "owner": {
+                "pid": os.getpid(),
+                "pgid": os.getpgrp(),
+                "start_id": start_id(os.getpid()),
+                "pid_namespace": os.readlink("/proc/self/ns/pid"),
+            },
+            "sources": sources,
+            "processes": [],
+            "adopted_processes": [],
+            "exclusive_subreaper": adopt_descendants,
+            "streams": [],
+            "output_directories": [str(self.root)],
+            "budgets": {
+                "processes": 16,
+                "callbacks": 16,
+                "streams": 4096,
+                "queue_events": 4096,
+                "queue_bytes": 8388608,
+                "body_bytes": 2097152,
+                "disk_bytes": 268435456,
+                "shutdown_seconds": 240,
+                "callback_seconds": 5,
+                "adopted_processes": 256,
+            },
+            "compose_project": None,
+            "containers": [],
+            "networks": [],
+            "volumes": [],
+            "listeners": [],
+            "cleanup_commands": [],
+            "status": "registered",
+            "errors": [],
+        }
+        self.persist()
+
+    def persist(self):
+        raw = (json.dumps(self.manifest, sort_keys=True, indent=2) + "\n").encode()
+        if len(raw) > 1024 * 1024:
+            raise ValueError("manifest budget")
+        with (self.root / "manifest.tmp").open("wb") as f:
+            f.write(raw)
+            f.flush()
+        (self.root / "manifest.tmp").replace(self.root / "manifest.json")
+
+    def spawn(self, command, *, stdout=subprocess.DEVNULL, env=None):
+        if self.closing is not None or len(self.children) >= 16:
+            raise ValueError("owner closed or process budget")
+        if (
+            not command
+            or len(command) > 64
+            or any(not isinstance(v, str) or len(v) > 4096 for v in command)
+        ):
+            raise ValueError("command budget")
+        row = {
+            "command": command,
+            "pid": None,
+            "pgid": None,
+            "start_id": None,
+            "status": "intent",
+            "reaped": False,
+        }
+        self.manifest["processes"].append(row)
+        self.persist()
+        child = subprocess.Popen(
+            command,
+            stdout=stdout,
+            stderr=subprocess.STDOUT,
+            env=env,
+            start_new_session=True,
+        )
+        # Register immediately after successful fork; failure to persist still leaves owned handle.
+        self.children.append((child, row))
+        _DIRECT_OWNERS[child.pid] = self
+        row.update(
+            pid=child.pid,
+            pgid=child.pid,
+            start_id=start_id(child.pid),
+            status="running",
+        )
+        self.manifest["cleanup_commands"].append(
+            {
+                "pid": child.pid,
+                "start_id": row["start_id"],
+                "command": ["kill", "-TERM", "--", str(child.pid)],
+                "guard": "verify PID namespace, PGID and start_id before signal; reap via owner",
+            }
+        )
+        try:
+            self.persist()
+        except BaseException:
+            child.terminate()
+            child.wait(timeout=5)
+            raise
+        return child
+
+    def register_close(self, name, callback):
+        if self.closing is not None or len(self.callbacks) >= 16:
+            raise ValueError("close registry budget")
+        self.callbacks.append((name, callback))
+
+    async def _reap_adopted(self):
+        """Exclusive runner only: newly adopted direct children descend from its worker.
+
+        Existing direct children and handles registered to another Owner are
+        excluded. Ordinary Owners never adopt this exclusive-process scope.
+        """
+        known = {}
+        for sig in (signal.SIGTERM, signal.SIGKILL):
+            deadline = time.monotonic() + 1
+            signalled = set()
+            while time.monotonic() < deadline:
+                candidates = [
+                    r
+                    for r in direct_children()
+                    if (r["pid"], r["start_id"]) not in self.baseline_children
+                    and (
+                        _DIRECT_OWNERS.get(r["pid"]) is None
+                        or _DIRECT_OWNERS.get(r["pid"]) is self
+                    )
+                ]
+                if not candidates:
+                    break
+                for entry in candidates:
+                    key = (entry["pid"], entry["start_id"])
+                    if key not in known:
+                        if len(known) >= 256:
+                            self.manifest["errors"].append("adopted_process_budget")
+                            return
+                        known[key] = {
+                            **entry,
+                            "pgid": os.getpgid(entry["pid"]),
+                            "reaped": False,
+                            "signals": [],
+                        }
+                        self.manifest["adopted_processes"].append(known[key])
+                    row = known[key]
+                    try:
+                        pid, _ = os.waitpid(entry["pid"], os.WNOHANG)  # noqa: ASYNC222
+                        if pid:
+                            row["reaped"] = True
+                            continue
+                        if (
+                            key not in signalled
+                            and start_id(entry["pid"]) == entry["start_id"]
+                        ):
+                            os.kill(entry["pid"], sig)
+                            row["signals"].append(sig.name)
+                            signalled.add(key)
+                    except (ProcessLookupError, ChildProcessError):
+                        pass
+                await asyncio.sleep(0.01)
+        survivors = [r for r in direct_children() if (r["pid"], r["start_id"]) in known]
+        self.manifest["adopted_survivors"] = survivors
+        if survivors:
+            self.manifest["errors"].append("adopted_process_cleanup_failed")
+
+    async def _shutdown(self):
+        self.manifest["status"] = "closing"
+        for name, callback in self.callbacks:
+            try:
+                value = callback()
+                if inspect.isawaitable(value):
+                    await asyncio.wait_for(value, timeout=5)
+            except (
+                Exception,  # noqa: BLE001 - cleanup must continue after callback failure
+                asyncio.CancelledError,
+            ) as error:
+                self.manifest["errors"].append(name + ":" + type(error).__name__)
+        for child, row in self.children:
+            # A unique session's group remains reserved while any descendants survive.
+            actions = []
+            for sig in (signal.SIGTERM, signal.SIGKILL):
+                try:
+                    if start_id(child.pid) != row["start_id"]:
+                        self.manifest["errors"].append("process_identity_changed")
+                        break
+                except FileNotFoundError:
+                    pass
+                for member in members(child.pid):
+                    try:
+                        if (
+                            os.getpgid(member["pid"]) == child.pid
+                            and start_id(member["pid"]) == member["start_id"]
+                        ):
+                            os.kill(member["pid"], sig)
+                            actions.append({**member, "signal": sig.name})
+                    except ProcessLookupError:
+                        pass
+                try:
+                    await asyncio.wait_for(
+                        asyncio.to_thread(child.wait, timeout=1), timeout=2
+                    )
+                except (TimeoutError, subprocess.TimeoutExpired):
+                    pass
+                # Reap descendants adopted by the offline runner's subreaper, when present.
+                until = time.monotonic() + 1
+                while time.monotonic() < until:
+                    try:
+                        while True:
+                            pid, _ = (
+                                os.waitpid(  # noqa: ASYNC222 - WNOHANG never blocks
+                                    -child.pid, os.WNOHANG
+                                )
+                            )
+                            if not pid:
+                                break
+                    except ChildProcessError:
+                        pass
+                    if not members(child.pid):
+                        break
+                    await asyncio.sleep(0.01)
+                if not members(child.pid):
+                    break
+            row.update(
+                status="stopped",
+                returncode=child.poll(),
+                reaped=child.returncode is not None,
+                actions=actions,
+                survivors=members(child.pid),
+            )
+            if row["survivors"] or not row["reaped"]:
+                self.manifest["errors"].append("process_cleanup_failed")
+            elif _DIRECT_OWNERS.get(child.pid) is self:
+                _DIRECT_OWNERS.pop(child.pid, None)
+        if self.adopt_descendants:
+            await self._reap_adopted()
+        self.manifest["status"] = (
+            "cleanup_failed" if self.manifest["errors"] else "clean"
+        )
+        self.persist()
+        return self.manifest
+
+    async def close(self):
+        if self.closing is None:
+            self.closing = asyncio.create_task(self._shutdown())
+        cancelled = False
+        while not self.closing.done():
+            try:
+                await asyncio.shield(self.closing)
+            except asyncio.CancelledError:
+                cancelled = True
+        result = self.closing.result()
+        if cancelled:
+            raise asyncio.CancelledError
+        return result
diff --git a/tools/diagnostics/perf391-diagnostic-integration-v1/run.py b/tools/diagnostics/perf391-diagnostic-integration-v1/run.py
new file mode 100644
index 00000000..ecb8ada9
--- /dev/null
+++ b/tools/diagnostics/perf391-diagnostic-integration-v1/run.py
@@ -0,0 +1,287 @@
+"""Offline Stage 4 runner. No image, browser, service or network entrypoint.
+
+`tests` owns one bounded child and records PID/PGID/start identities before
+execution. `analyze` consumes capped JSONL files already on disk. The parent
+is a child subreaper so terminated test descendants are joined, never orphaned.
+"""
+
+import argparse
+import asyncio
+import ctypes
+import json
+import os
+import signal
+import sys
+from pathlib import Path
+
+import build
+from analyze import analyze
+from evidence import canonical
+from owner import Owner
+
+PACKAGE = Path(__file__).resolve().parent
+MODULES = (
+    "analyze.py",
+    "collector.py",
+    "collect.mjs",
+    "diagnostic_app.py",
+    "evidence.py",
+    "host.py",
+    "integration.py",
+    "observer.mjs",
+    "owner.py",
+    "run.py",
+    "backend_probe.py",
+    "workers.py",
+    "browser.mjs",
+    "browser-probe.ts",
+    "contract.py",
+    "contract.json",
+    "integration-event-schema.json",
+    "verify_evidence.py",
+    "analysis-schema.json",
+    "summary-schema.json",
+    "build.py",
+    "verify.py",
+    "verify_backend.py",
+    "verify_frontend.py",
+    "frontend-config.mjs",
+    "build-manifest-schema.json",
+    "requirements-test.txt",
+)
+
+
+def source_identity(repo):
+    return {
+        "starting_commit": "8faeac62601720cec711d0a6ddc97f18a497cb09",
+        "integration_commit": build.git(repo, "rev-parse", "HEAD").decode().strip(),
+        "pins": build.PINS,
+        "modules": {
+            name: build.digest((PACKAGE / name).read_bytes()) for name in MODULES
+        },
+        "patches": {
+            name: build.digest((PACKAGE / "patches" / name).read_bytes())
+            for name in (
+                "A.patch",
+                "A.json",
+                "C.patch",
+                "C.json",
+                "frontend/A.patch",
+                "frontend/A.json",
+                "frontend/C.patch",
+                "frontend/C.json",
+            )
+        },
+    }
+
+
+def read_jsonl(path, *, max_bytes=32 * 1024 * 1024, max_events=100000):
+    total = 0
+    rows = []
+    with Path(path).open("rb") as stream:
+        while True:
+            raw = stream.readline(1048577)
+            if not raw:
+                break
+            total += len(raw)
+            if len(raw) > 1048576 or total > max_bytes or len(rows) >= max_events:
+                raise ValueError("offline input budget")
+            rows.append(json.loads(raw))
+    return rows
+
+
+async def run_tests(output, *, pattern="test_*.py"):
+    libc = ctypes.CDLL(None, use_errno=True)
+    if libc.prctl(36, 1, 0, 0, 0) != 0:
+        raise OSError(ctypes.get_errno(), "child subreaper unavailable")
+    owner = Owner(
+        output,
+        run="synthetic-stage4",
+        sources=source_identity(PACKAGE.parents[2]),
+        adopt_descendants=True,
+    )
+    command = [
+        sys.executable,
+        "-B",
+        "-m",
+        "coverage",
+        "run",
+        "--branch",
+        "--source=backend_probe,workers,build,contract,collector,diagnostic_app,evidence,host,integration,owner,analyze,verify_evidence,run",
+        "tests/owned_suite.py",
+        pattern,
+    ]
+    loop = asyncio.get_running_loop()
+    interrupted = asyncio.Event()
+    for sig in (signal.SIGTERM, signal.SIGINT):
+        loop.add_signal_handler(sig, interrupted.set)
+    result = 1
+    child = None
+    with (owner.root / "tests.log").open("wb") as log:
+        try:
+            child = owner.spawn(
+                command,
+                stdout=log,
+                env={
+                    **os.environ,
+                    "PYTHONDONTWRITEBYTECODE": "1",
+                    "COVERAGE_FILE": str(owner.root / "coverage.data"),
+                },
+            )
+            # PID remains reserved until cleanup. waitpid WNOWAIT observes exit without reaping.
+            deadline = loop.time() + 120
+            while loop.time() < deadline and not interrupted.is_set():
+                status = os.waitid(  # noqa: ASYNC222 - WNOHANG observes without blocking/reaping
+                    os.P_PID, child.pid, os.WEXITED | os.WNOHANG | os.WNOWAIT
+                )
+                if status is not None:
+                    result = (
+                        status.si_status
+                        if status.si_code == os.CLD_EXITED
+                        else 128 + status.si_status
+                    )
+                    break
+                await asyncio.sleep(0.02)
+            else:
+                owner.manifest["errors"].append("test_timeout_or_signal")
+        finally:
+            await owner.close()
+            for sig in (signal.SIGTERM, signal.SIGINT):
+                loop.remove_signal_handler(sig)
+    print(json.dumps(owner.manifest, indent=2))
+    return result if owner.manifest["status"] == "clean" else 1
+
+
+def integrate_offline(output, *, role, backend_file, stats_file, node_root=None):
+    from collector import prepare_collector
+    from evidence import Evidence
+    from integration import Integration
+    from verify_evidence import validate_document, verify_analysis, verify_artifacts
+
+    repo = PACKAGE.parents[2]
+    backend = read_jsonl(backend_file)
+    run = backend[0]["run_id"] if backend else "synthetic-stage4"
+    owner = Owner(output, run=run, sources=source_identity(repo))
+    collector = prepare_collector(owner.root / "collector", repo)
+    sink = Evidence(owner.root / "evidence", collector, run=run)
+    adapter = Integration(sink, role=role, run=run)
+    try:
+        adapter.backend(backend)
+        if stats_file.stat().st_size > 1048576:
+            raise ValueError("backend stats budget")
+        adapter.finish_backend(json.loads(stats_file.read_bytes()))
+        if node_root is not None:
+            verify_artifacts(node_root)
+            raw_summary = node_root / "summary.json"
+            if raw_summary.stat().st_size > 1048576:
+                raise ValueError("node summary budget")
+            summary = json.loads(raw_summary.read_bytes())
+            if summary["run"] != run:
+                raise ValueError("node/backend run mismatch")
+
+            def load(reference):
+                name = reference["path"]
+                path = node_root / name
+                if (
+                    path.is_symlink()
+                    or node_root.resolve() not in path.resolve().parents
+                    or path.stat().st_size > 2097152
+                ):
+                    raise ValueError("artifact path/body budget")
+                return path.read_bytes()
+
+            for raw in read_jsonl(node_root / "records.jsonl"):
+                if raw.get("origin") == "observer":
+                    adapter.source_record(raw)
+                elif raw.get("origin") == "source-body":
+                    body = load(raw["artifact"])
+                    reference = sink.artifact(body)
+                    adapter._v1(
+                        "body",
+                        {
+                            "viewer": "source-observer",
+                            "request_id": raw["op"],
+                            "status": raw["status"],
+                            "artifact": reference,
+                        },
+                        op=raw["op"],
+                    )
+                else:
+                    adapter.browser_record(raw, load=load)
+            browser = summary.get("browsers", [])
+            adapter.finish_browser(
+                {
+                    "closed": summary["closed"],
+                    "failed": not summary["complete"],
+                    "lost": summary["dropped"] + sum(s["lost"] for s in browser),
+                    "ownedOperations": sum(s["ownedOperations"] for s in browser),
+                }
+            )
+            for source in summary.get("sources", []):
+                adapter.finish_source(source)
+        result = sink.close()
+        validate_document(result, "summary")
+        verify_artifacts(sink.root)
+        rows = read_jsonl(sink.root / "integration.jsonl")
+        report = analyze(rows, result)
+        verify_analysis(report, rows)
+        (owner.root / "analysis.json").write_bytes(canonical(report) + b"\n")
+        owner.manifest["streams"] = result["streams"]
+        owner.manifest["output_directories"].append(str(sink.root))
+        owner.manifest["status"] = "clean"
+        owner.persist()
+        return {"evidence": result, "analysis": report}
+    finally:
+        if not sink.closed:
+            sink.close()
+        # Offline integration creates no child processes or external runtime objects.
+        if owner.manifest["status"] != "clean":
+            owner.manifest["status"] = "failed_no_runtime_resources"
+            owner.persist()
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    sub = parser.add_subparsers(dest="command", required=True)
+    tests = sub.add_parser("tests")
+    tests.add_argument("--output", type=Path, required=True)
+    tests.add_argument("--pattern", default="test_*.py")
+    report = sub.add_parser("analyze")
+    report.add_argument("--events", type=Path, required=True)
+    report.add_argument("--summary", type=Path, required=True)
+    report.add_argument("--output", type=Path, required=True)
+    integration = sub.add_parser("integrate")
+    integration.add_argument("--output", type=Path, required=True)
+    integration.add_argument("--role", choices=["A", "C"], required=True)
+    integration.add_argument("--backend", type=Path, required=True)
+    integration.add_argument("--stats", type=Path, required=True)
+    integration.add_argument("--node-root", type=Path)
+    args = parser.parse_args()
+    if args.command == "tests":
+        return asyncio.run(run_tests(args.output, pattern=args.pattern))
+    if args.command == "integrate":
+        result = integrate_offline(
+            args.output,
+            role=args.role,
+            backend_file=args.backend,
+            stats_file=args.stats,
+            node_root=args.node_root,
+        )
+        return (
+            0
+            if result["evidence"]["complete"]
+            and result["analysis"]["integrity"]["complete"]
+            else 1
+        )
+    rows = read_jsonl(args.events)
+    if args.summary.stat().st_size > 1048576:
+        raise ValueError("summary budget")
+    summary = json.loads(args.summary.read_bytes())
+    result = analyze(rows, summary)
+    with args.output.open("xb") as f:
+        f.write(canonical(result) + b"\n")
+    return 0 if result["integrity"]["complete"] else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

+      op: "x",
+      request: t.request,
+      signal: c.signal,
+      timers: {
+        setTimeout: (fn) => {
+          timeout = fn;
+          return 1;
+        },
+        clearTimeout: () => cleared++,
+      },
+    });
+    await new Promise((resolve) => queueMicrotask(resolve));
+    if (cancel) c.abort();
+    else timeout();
+    assert.equal((await pending).reason, cancel ? "cancelled" : "deadline");
+    assert.ok(t.destroyed > 0);
